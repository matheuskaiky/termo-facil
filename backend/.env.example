# backend/.env.example — Template for backend/.env
# This file is git-tracked and serves as documentation.
#
# To use: copy to backend/.env and fill in values.
# IMPORTANT: backend/.env is gitignored — never commit real credentials.

# ─────────────────────────────────────────────────────────────────────────────
# Database — PostgreSQL 15+
# ─────────────────────────────────────────────────────────────────────────────
# Docker mode: docker-compose.yml starts PostgreSQL on 5432
# HPC mode:    hpc/setup.sh initializes the cluster with these exact credentials
#
# The same .env works in both modes because:
#   - PostgreSQL server listens on 127.0.0.1:5432 in both cases
#   - User/password are created identically by initdb or docker-entrypoint
#
POSTGRES_SERVER=127.0.0.1
POSTGRES_USER=termo_user
POSTGRES_PASSWORD=termo_password
POSTGRES_PORT=5432
POSTGRES_DB=termo_facil

# ─────────────────────────────────────────────────────────────────────────────
# Redis / Celery — Task queue and result backend
# ─────────────────────────────────────────────────────────────────────────────
# Docker mode: Compose starts Redis on 6379 with AOF persistence
# HPC mode:    hpc/start.sh starts user-space Redis on the same port
#
REDIS_URL=redis://127.0.0.1:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# MinIO — S3-compatible Object Storage for audio files and PDFs
# ─────────────────────────────────────────────────────────────────────────────
# Docker mode: Compose starts MinIO (API on 9000, console on 9001)
# HPC mode:    hpc/start.sh runs the standalone binary on the same ports
#
# Buckets created automatically on startup by minio_service.py:
#   - audio-uploads   (raw recorded testimony audio)
#   - termos-finais   (final PDF documents)
#
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=adminpassword

# ─────────────────────────────────────────────────────────────────────────────
# ASR — Automatic Speech Recognition (Whisper)
# ─────────────────────────────────────────────────────────────────────────────
# Models: tiny, base, small, medium, large, turbo
# Recommendation:
#   - Development:  'base' (fast, reasonable accuracy)
#   - HPC with GPU: 'large-v3' or 'turbo' (higher accuracy, longer runtime;
#     'large-v3' acerta muito mais nomes próprios em PT-BR e cabe nas L4 22GB)
#
WHISPER_MODEL_SIZE=base

# ─────────────────────────────────────────────────────────────────────────────
# Diarização / Separação de falantes
# ─────────────────────────────────────────────────────────────────────────────
# DIARIZATION_PROVIDER:
#   - 'heuristic' (default): alternância de falante por pausa (sem modelo extra)
#   - 'pyannote': PixIT — diarização + speech separation conjuntas
#       (pyannote/speaker-diarization-3.1 + pyannote/speech-separation-ami-1.0).
#       Para ligar: aceite os termos das DUAS páginas em hf.co e defina o token.
#
DIARIZATION_PROVIDER=heuristic
PYANNOTE_HF_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# LLM — Large Language Model for legal document generation
# ─────────────────────────────────────────────────────────────────────────────
# Development: Ollama (single GPU friendly, `ollama serve` starts on 11434)
# Production: vLLM or other inference server
#
# Temperature is always 0.0 in code (RN-01 legal requirement) — never change.
# This ensures deterministic, non-hallucinating output required by LGPD.
#
LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=llama3

# ─────────────────────────────────────────────────────────────────────────────
# NER — Named Entity Recognition (LeNER-Br for Portuguese legal text)
# ─────────────────────────────────────────────────────────────────────────────
# This model is downloaded from HuggingFace on first use (requires internet).
# On air-gapped HPC: download manually and set to the local path instead.
#
# Example: /opt/models/lener_br  or  $HOME/models/alfaneo-lener_br
#
NER_MODEL_NAME=alfaneo/lener_br

# ─────────────────────────────────────────────────────────────────────────────
# Security — JWT Secret for authentication tokens
# ─────────────────────────────────────────────────────────────────────────────
# CRITICAL: Change this to a long random string in any non-development environment.
#
# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# The application will refuse to start in APP_ENV=production with the
# default value shown below. This is intentional — a production deployment
# must not use a placeholder secret.
#
JWT_SECRET_KEY=troque-esta-chave-antes-de-ir-para-producao

# ─────────────────────────────────────────────────────────────────────────────
# Application Environment
# ─────────────────────────────────────────────────────────────────────────────
# development  → permissive, dev fallbacks enabled
# production   → strict, security checks enforced, JWT key required
#
# APP_ENV=development
